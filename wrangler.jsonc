/* 묘연 — Cloudflare Workers 설정 (정적 에셋 app/ + 예약 API worker/ + D1)
   D1 연결 완료 (2026-07-14) — 스키마는 워커가 첫 요청 시 자동 생성 */
{
  "name": "myoyeon",
  "compatibility_date": "2026-06-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "app",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "myoyeon-db", "database_id": "e51da453-2a09-4410-bf6b-11c6229760ff" }
  ]
}
